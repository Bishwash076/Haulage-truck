# ══════════════════════════════════════════════════════════════════════
# 2. EQUATION IMPLEMENTATIONS
# ══════════════════════════════════════════════════════════════════════
def static_efficiency(Q, H1, H2, P_sh):
    return Q * (H1 - H2) / P_sh

def affinity_power(N_ratio):
    return P_BASE * N_ratio**3

def affinity_head(N_ratio):
    return H_BASE * N_ratio**2

def affinity_flow(N_ratio):
    return Q_BASE * N_ratio

def savings_fraction(N_ratio):
    return 1.0 - N_ratio**3

def fan_energy(T_o, L_F, W_F):
    return T_o * L_F * W_F

def energy_saved(T_o, SP_F, W_F):
    return T_o * SP_F * W_F

def ghg_reduction(ES_Fan, coal_pct):
    return ES_Fan * coal_pct * (EF_CO2 + EF_SO2 + EF_NOX)

def payback(C_TE, C_TS):
    return C_TE / C_TS

