for c in countries:
    Wf       = FAN_POW[c]
    sp_arr   = savings_fraction(speed_ratios)
    es_arr   = energy_saved(HOURS_YR * LOAD_F, sp_arr, Wf)
    cost_arr = es_arr * TARIFF[c]
    ghg_arr  = ghg_reduction(es_arr, COAL_PCT[c]) / 1000
    cap      = CAPEX_100[c] * Wf / 100
    opex_yr  = OPEX_100[c] * Wf / 100
    pbp_arr  = np.where(cost_arr > opex_yr,
                        payback(cap, cost_arr - opex_yr), np.nan)
    eta_arr  = np.clip(ETA_S * (1 - 0.15*(1 - speed_ratios)**1.5), 0.40, ETA_S)
    vsd[c]   = dict(
        es=es_arr, cost=cost_arr, ghg=ghg_arr,
        pbp=pbp_arr, Wf=Wf, capex=cap, opex=opex_yr,
